# /etc/whatsapp-mcp/<account>.env -- one file per WhatsApp account.
# Owned root:whatsapp, mode 0640: it holds the bearer token.
# Each account needs its own ports and store directory.

# Bridge
WHATSAPP_BRIDGE_PORT=8080
WHATSAPP_STORE_DIR=/var/lib/whatsapp-mcp/<account>/store

# MCP server
WHATSAPP_API_BASE_URL=http://127.0.0.1:8080/api
WHATSAPP_MESSAGES_DB=/var/lib/whatsapp-mcp/<account>/store/messages.db
WHATSAPP_MCP_HOST=127.0.0.1
WHATSAPP_MCP_PORT=9000
# The public address Claude uses, including the path prefix the proxy routes on.
WHATSAPP_MCP_PUBLIC_URL=https://<your-domain>/<account>
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
WHATSAPP_MCP_TOKEN=<generate-me>
